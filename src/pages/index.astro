---
import Layout from '../layouts/Layout.astro'; import {posts} from '../data/posts.js'; const latest=posts.slice(0,20);
---
<Layout title="Educație Relațională"><h1>Educație Relațională</h1><p>Articole despre relații, cuplu, emoții și dezvoltare personală.</p>{latest.map(p=><article><h2><a href={`/${p.slug}/`}>{p.title}</a></h2><div class="post-meta">{p.date}</div>{p.excerpt&&<p>{p.excerpt}</p>}</article>)}</Layout>
