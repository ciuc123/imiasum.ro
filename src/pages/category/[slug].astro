---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { posts } from '../../data/posts.js';
import categories from '../../data/categories.json';
import { getCategoryPosts, getPage } from '../../lib/content.js';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const pageData = getPage(getCategoryPosts(posts, category.slug), 1);
---

<Layout title={`Categoria: ${category.name}`}>
  <header class="page-heading">
    <p class="eyebrow">Categorie</p>
    <h1>{category.name}</h1>
    <p>Articole din categoria {category.name}.</p>
  </header>
  <PostList posts={pageData.items} showExcerpt />
  <Pagination basePath={`/category/${category.slug}/`} {...pageData} />
</Layout>
