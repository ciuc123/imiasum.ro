---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { posts } from '../../data/posts.js';
import categories from '../../data/categories.json';
import { getCategoryPosts, getPage } from '../../lib/content.js';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const categoryPosts = getCategoryPosts(posts, category.slug);
const pageData = getPage(categoryPosts, 1);
---

<Layout
  title={`Categoria: ${category.name}`}
  description={`Articole din categoria ${category.name}, într-o listare clară și ușor de parcurs.`}
  breadcrumbs={[{ label: 'Toate postările', href: '/blog/' }, { label: category.name }]}
  navSection="blog"
  currentCategorySlug={category.slug}
>
  <header class="page-hero">
    <div class="page-hero-copy">
      <p class="eyebrow">Categorie activă</p>
      <h1>{category.name}</h1>
      <p>Vezi doar articolele din această temă, cu aceleași controale de căutare și aceeași paginare ca în restul blogului.</p>
    </div>
    <div class="page-hero-meta">
      <span class="context-pill">{categoryPosts.length} articole</span>
      <span class="context-pill">Pagina {pageData.currentPage} din {pageData.totalPages}</span>
    </div>
  </header>
  <PostList posts={pageData.items} showExcerpt />
  <Pagination basePath={`/category/${category.slug}/`} {...pageData} />
</Layout>
