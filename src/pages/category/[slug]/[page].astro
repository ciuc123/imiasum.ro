---
import Layout from '../../../layouts/Layout.astro';
import PostList from '../../../components/PostList.astro';
import Pagination from '../../../components/Pagination.astro';
import { posts } from '../../../data/posts.js';
import categories from '../../../data/categories.json';
import { getCategoryPosts, getPage, POSTS_PER_PAGE } from '../../../lib/content.js';

export function getStaticPaths() {
  return categories.flatMap((category) => {
    const totalPages = Math.ceil(getCategoryPosts(posts, category.slug).length / POSTS_PER_PAGE);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
      params: { slug: category.slug, page: String(index + 2) },
      props: { category, page: index + 2 },
    }));
  });
}

const { category, page } = Astro.props;
const categoryPosts = getCategoryPosts(posts, category.slug);
const pageData = getPage(categoryPosts, page);
---

<Layout
  title={`Categoria: ${category.name} – pagina ${pageData.currentPage}`}
  description={`Articole din categoria ${category.name}, pagina ${pageData.currentPage} din ${pageData.totalPages}.`}
  breadcrumbs={[
    { label: 'Toate postările', href: '/blog/' },
    { label: category.name, href: `/category/${category.slug}/` },
    { label: `Pagina ${pageData.currentPage}` }
  ]}
  navSection="blog"
  currentCategorySlug={category.slug}
>
  <header class="page-hero">
    <div class="page-hero-copy">
      <p class="eyebrow">Categorie activă</p>
      <h1>{category.name}</h1>
      <p>Ești în pagina {pageData.currentPage} din {pageData.totalPages} pentru această categorie, cu context clar și navigare consistentă.</p>
    </div>
    <div class="page-hero-meta">
      <span class="context-pill">{categoryPosts.length} articole</span>
      <span class="context-pill">Pagina {pageData.currentPage} din {pageData.totalPages}</span>
    </div>
  </header>
  <PostList posts={pageData.items} showExcerpt />
  <Pagination basePath={`/category/${category.slug}/`} {...pageData} />
</Layout>
