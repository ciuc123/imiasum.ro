---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { posts } from '../../data/posts.js';
import { getPage, pageUrl } from '../../lib/content.js';

const pageData = getPage(posts, 1);
---

<Layout title="Blog" canonical={pageUrl('/blog/', pageData.currentPage)}>
  <header class="page-heading">
    <p class="eyebrow">Educație relațională</p>
    <h1>Blog</h1>
    <p>Idei despre relații, cuplu, emoții și dezvoltare personală.</p>
  </header>
  <div class="section-heading">
    <h2 class="section-title">Articole</h2>
  </div>

  <div id="blog-list">
    <PostList posts={pageData.items} showExcerpt />
    <Pagination basePath="/blog/" {...pageData} />
  </div>
</Layout>
