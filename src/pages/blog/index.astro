---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { posts } from '../../data/posts.js';
import { getPage, pageUrl } from '../../lib/content.js';

const pageData = getPage(posts, 1);
---

<Layout title="Toate postarile" canonical={pageUrl('/blog/', pageData.currentPage)}>
  <div id="blog-list">
    <PostList posts={pageData.items} showExcerpt />
    <Pagination basePath="/blog/" {...pageData} />
  </div>
</Layout>
