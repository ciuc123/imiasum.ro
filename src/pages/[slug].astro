---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts.js';
import PostPreviewCards from '../components/PostPreviewCards.astro';

export function getStaticPaths() {
  return posts.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const primaryCategory = item.categories?.[0] || null;
---
<Layout
  title={item.title}
  description={item.excerpt || item.title}
  breadcrumbs={[
    { label: 'Toate postările', href: '/blog/' },
    ...(primaryCategory ? [{ label: primaryCategory.name, href: `/category/${primaryCategory.slug}/` }] : []),
    { label: item.title }
  ]}
  navSection="blog"
  currentCategorySlug={primaryCategory?.slug || ''}
>
  <article class="post-detail">
    <header class="post-hero">
      <p class="eyebrow">Articol</p>
      <h1>{item.title}</h1>
      {item.excerpt && <p class="post-detail-excerpt">{item.excerpt}</p>}
      <div class="post-hero-meta">
        {item.date && <p class="post-meta"><time datetime={item.date}>{item.date}</time></p>}
        {primaryCategory && <span class="context-pill">Categoria activă: {primaryCategory.name}</span>}
      </div>
    </header>
    {item.categories?.length > 0 && <div class="post-categories post-categories-detail" aria-label="Categorii">
      {item.categories.map((category) => <a href={`/category/${category.slug}/`}>{category.name}</a>)}
    </div>}
    <div class="post-content" set:html={item.content}></div>
    <PostPreviewCards posts={posts} currentSlug={item.slug} />
  </article>
</Layout>
