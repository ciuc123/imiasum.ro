---
import Layout from '../layouts/Layout.astro'; import {posts} from '../data/posts.js'; import pages from '../data/pages.json'; const items=[...posts,...pages];
export function getStaticPaths(){return items.map(p=>({params:{slug:p.slug},props:{item:p}}));} const {item}=Astro.props;
---
<Layout title={item.title}><article><h1>{item.title}</h1><div class="post-meta">{item.date}</div><div class="content" set:html={item.content}></div></article></Layout>
