---
const {
    title = 'Educație Relațională',
    description = 'Educație Relațională'
} = Astro.props;
---

<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="stylesheet" href="/styles.css" />
</head>

<body>
<header>
    <a href="/">Educație Relațională</a>
    <nav>
        <a href="/blog/">Blog</a>
    </nav>
</header>

<main>
    <slot />
</main>

<footer>
    Educație Relațională
</footer>
</body>
</html>