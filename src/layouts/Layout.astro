---
import categories from '../data/categories.json';
import { posts } from '../data/posts.js';

  const {
    title = 'Educație Relațională',
    description = 'Educație Relațională',
    canonical = null
  } = Astro.props;

  const FALLBACK_POSTS_JSON = JSON.stringify(posts.map(p=>({slug:p.slug,title:p.title,excerpt:p.excerpt||'',content:p.content||'',date:p.date})));
---

<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical || Astro.url.href} />
    <link rel="stylesheet" href="/styles.css" />
</head>

<body>
<header class="site-header" id="site-header">
    <div class="header-top">
        <a class="site-title" href="/">Educație Relațională</a>

        <div class="header-search-desktop">
            <div class="search-box">
                <input id="global-search-input" type="search" placeholder="Caută articole..." aria-label="Caută articole" />
                <button id="global-search-button">Caută</button>
            </div>
        </div>

        <nav class="primary-nav" aria-label="Navigare principală">
            <a href="/blog/">Toate postarile</a>
        </nav>

        <!-- Mobile hamburger toggle for Blog + Categories -->
        <button class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-nav-panel">
            <span class="hamburger" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            <span class="visually-hidden">Meniu</span>
        </button>
    </div>

    <!-- Mobile search bar (inside header on mobile) -->
    <div class="header-search-mobile">
        <div class="search-box">
            <input id="global-search-input-mobile" type="search" placeholder="Caută articole..." aria-label="Caută articole" />
            <button id="global-search-button-mobile">Caută</button>
        </div>
    </div>

    <div id="mobile-nav-panel" class="mobile-nav-panel" role="dialog" aria-modal="true" hidden>
        <div class="mobile-nav-panel-inner">
            <header class="mobile-nav-panel-header">
                <h2>Navigare</h2>
                <button class="mobile-nav-close" aria-label="Închide meniu">✕</button>
            </header>
            <nav class="nav-section" aria-label="Secțiuni principale">
                <a href="/blog/" class="nav-section-link">Toate postarile</a>
            </nav>
            <nav class="nav-section" aria-label="Categorii">
                <h3 class="nav-section-title">Categorii</h3>
                {categories.map((category) => <a href={`/category/${category.slug}/`} class="nav-category-link">{category.name}</a>)}
            </nav>
        </div>
    </div>
</header>


<div class="site-layout">
    <main>
        <!-- Global search results container -->
        <div id="global-search-results" style="display:none;"></div>

        <!-- Main page content -->
        <div id="main-content">
            <slot />
        </div>
    </main>

    <aside class="category-sidebar" aria-labelledby="categories-heading">
        <h2 id="categories-heading">Categorii</h2>
        <nav aria-label="Categorii">
            {categories.map((category) => <a href={`/category/${category.slug}/`}>{category.name}</a>)}
        </nav>
    </aside>
</div>

<!-- Inject fallback posts JSON before the search module -->
<script set:html={`window.FALLBACK_POSTS = ${FALLBACK_POSTS_JSON};`}></script>

<!-- Header scroll behavior (hide/show on scroll) -->
<script>
  (function(){
    const header = document.getElementById('site-header');
    if (!header) return;

    let lastScrollY = 0;
    let isHeaderHidden = false;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;

      // If scrolling down and past 50px, hide header
      if (currentScrollY > lastScrollY && currentScrollY > 50 && !isHeaderHidden) {
        header.classList.add('header-hidden');
        isHeaderHidden = true;
      }
      // If scrolling up, show header
      else if (currentScrollY < lastScrollY && isHeaderHidden) {
        header.classList.remove('header-hidden');
        isHeaderHidden = false;
      }

      lastScrollY = currentScrollY;
    }, false);
  })();
</script>
<script>
  (function(){
    try {
      const btn = document.querySelector('.mobile-nav-toggle');
      const panel = document.getElementById('mobile-nav-panel');
      if (!btn || !panel) return;
      const closeBtn = panel.querySelector('.mobile-nav-close');

      let previouslyFocused = null;
      let trapHandler = null;
      let closeTimeoutId = null;
      let closeTransitionHandler = null;

      function getFocusableElements(container){
        return Array.from(container.querySelectorAll('a[href], button:not([disabled]), input, textarea, [tabindex]:not([tabindex="-1"])'))
          .filter((el) => el.offsetWidth > 0 || el.offsetHeight > 0);
      }

      function openPanel(){
        previouslyFocused = document.activeElement;
        if (closeTimeoutId) { clearTimeout(closeTimeoutId); closeTimeoutId = null; }
        if (closeTransitionHandler) { panel.removeEventListener('transitionend', closeTransitionHandler); closeTransitionHandler = null; }

        panel.removeAttribute('hidden');
        requestAnimationFrame(()=> panel.classList.add('open'));
        btn.setAttribute('aria-expanded','true');
        document.body.style.overflow = 'hidden';

        const focusable = getFocusableElements(panel);
        if (focusable.length) focusable[0].focus();

        trapHandler = function(e){
          if (e.key !== 'Tab') return;
          const nodes = getFocusableElements(panel);
          if (!nodes.length) return;
          const first = nodes[0];
          const last = nodes[nodes.length - 1];
          if (e.shiftKey && document.activeElement === first){
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last){
            e.preventDefault(); first.focus();
          }
        };
        panel.addEventListener('keydown', trapHandler);
      }

      function closePanel(){
        panel.classList.remove('open');
        btn.setAttribute('aria-expanded','false');
        try { if (trapHandler) panel.removeEventListener('keydown', trapHandler); } catch (err) { /* ignore */ }
        const onEnd = (e)=>{
          if (e.target !== panel && !panel.contains(e.target)) return;
          panel.setAttribute('hidden','');
          if (closeTransitionHandler) { panel.removeEventListener('transitionend', closeTransitionHandler); }
          closeTransitionHandler = null;
          document.body.style.overflow = '';
          try { previouslyFocused && previouslyFocused.focus && previouslyFocused.focus(); } catch (err) { /* ignore */ }
        };
        const clearFallback = ()=>{ if (closeTimeoutId) { clearTimeout(closeTimeoutId); closeTimeoutId = null; } };
        closeTransitionHandler = (e) => { onEnd(e); clearFallback(); };
        panel.addEventListener('transitionend', closeTransitionHandler);
        closeTimeoutId = setTimeout(()=>{ try { onEnd({ target: panel }); } catch (_){}; clearFallback(); }, 350);
      }

      btn.addEventListener('click', function(){
        if (panel.hasAttribute('hidden')) openPanel(); else closePanel();
      });
      closeBtn && closeBtn.addEventListener('click', closePanel);
      panel.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePanel(); });
      panel.addEventListener('click', function(e){ if (e.target === panel) closePanel(); });
    } catch (err) { console.error(err); }
  })();
</script>

<script type="module">
  // Global search across all pages
  let POSTS = null;

  async function loadPostsIndex(){
    if (POSTS) return POSTS;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) { POSTS = await res.json(); return POSTS; }
    } catch(e) {}
    POSTS = window.FALLBACK_POSTS || [];
    return POSTS;
  }

  // Desktop search
  const desktopInput = document.getElementById('global-search-input');
  const desktopButton = document.getElementById('global-search-button');

  // Mobile search
  const mobileInput = document.getElementById('global-search-input-mobile');
  const mobileButton = document.getElementById('global-search-button-mobile');

  async function performSearch(query){
    if (query.length < 3) return null;
    await loadPostsIndex();
    return POSTS.filter(p =>
      (p.title||'').toLowerCase().includes(query) ||
      (p.excerpt||'').toLowerCase().includes(query) ||
      (p.content||'').toLowerCase().includes(query)
    );
  }

   // Desktop search
   if (desktopButton && desktopInput) {
     desktopButton.addEventListener('click', async () => {
       const q = desktopInput.value.trim().toLowerCase();
       if (q.length < 3) return;
       const results = await performSearch(q);
       displaySearchResults(results, 1);
     });
     desktopInput.addEventListener('keydown', (e) => {
       if (e.key === 'Enter') desktopButton.click();
     });
   }

   // Handle mobile search
   if (mobileButton && mobileInput) {
     mobileButton.addEventListener('click', async () => {
       const q = mobileInput.value.trim().toLowerCase();
       if (q.length < 3) return;
       const results = await performSearch(q);
       displaySearchResults(results, 1);
       // Scroll to results on mobile
       setTimeout(() => {
         const resultsEl = document.getElementById('global-search-results');
         if (resultsEl && resultsEl.style.display !== 'none') {
           resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
         }
       }, 100);
     });
     mobileInput.addEventListener('keydown', (e) => {
       if (e.key === 'Enter') mobileButton.click();
     });
   }

    // Display search results with pagination
    function displaySearchResults(allResults, page = 1) {
      const resultsEl = document.getElementById('global-search-results');
      const mainContent = document.getElementById('main-content');
      if (!resultsEl || !mainContent) return;

      const PER_PAGE = 10;
      const totalPages = Math.ceil(allResults.length / PER_PAGE);
      const start = (page - 1) * PER_PAGE;
      const pageItems = allResults.slice(start, start + PER_PAGE);

      resultsEl.innerHTML = '';
      mainContent.style.display = 'none';

      // Success message
      const message = document.createElement('div');
      message.className = 'search-success-message';
      message.innerHTML = `<p>S-au găsit <strong>${allResults.length}</strong> rezultat${allResults.length !== 1 ? 'e' : ''}:</p>`;
      resultsEl.appendChild(message);

      if (pageItems.length === 0) {
        resultsEl.innerHTML = '<p style="padding: 20px; text-align: center; color: #746d76;">Nu s-au găsit rezultate.</p>';
        resultsEl.style.display = 'block';
        return;
      }

      // Results list
      const list = document.createElement('div');
      list.className = 'post-list';
      for (const p of pageItems) {
        const article = document.createElement('article');
        article.className = 'post-card';
        article.innerHTML = `<p class="post-meta"><time datetime="${p.date}">${p.date||''}</time></p><h2><a href="/${p.slug}/">${p.title}</a></h2>${p.excerpt?`<p class="post-excerpt">${p.excerpt}</p>`:''}`;
        list.appendChild(article);
      }
      resultsEl.appendChild(list);

      // Pagination
      if (totalPages > 1) {
        const pager = document.createElement('nav');
        pager.className = 'pagination';
        pager.setAttribute('aria-label', 'Paginare rezultate');

        // Navigation wrapper (for mobile stacking)
        const navWrapper = document.createElement('div');
        navWrapper.className = 'pagination-nav-wrapper';

        // Helper function to get smart page range
        function getVisiblePages(current, total) {
          const pages = new Set();
          const range = 3;
          // First 3
          for (let i = 1; i <= Math.min(3, total); i++) pages.add(i);
          // Last 3
          for (let i = Math.max(1, total - 2); i <= total; i++) pages.add(i);
          // Around current
          for (let i = Math.max(1, current - range); i <= Math.min(total, current + range); i++) pages.add(i);
          return Array.from(pages).sort((a, b) => a - b);
        }

        const visiblePages = getVisiblePages(page, totalPages);

        // Previous button
        if (page > 1) {
          const prev = document.createElement('a');
          prev.href = '#';
          prev.textContent = '← Anterior';
          prev.addEventListener('click', (e) => {
            e.preventDefault();
            displaySearchResults(allResults, page - 1);
            resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          navWrapper.appendChild(prev);
        } else {
          const span = document.createElement('span');
          span.className = 'pagination-disabled';
          span.textContent = '← Anterior';
          navWrapper.appendChild(span);
        }

        // Page info
        const info = document.createElement('span');
        info.className = 'pagination-info';
        info.textContent = `Pagina ${page} din ${totalPages}`;
        navWrapper.appendChild(info);

        // Next button
        if (page < totalPages) {
          const next = document.createElement('a');
          next.href = '#';
          next.textContent = 'Următor →';
          next.addEventListener('click', (e) => {
            e.preventDefault();
            displaySearchResults(allResults, page + 1);
            resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          navWrapper.appendChild(next);
        } else {
          const span = document.createElement('span');
          span.className = 'pagination-disabled';
          span.textContent = 'Următor →';
          navWrapper.appendChild(span);
        }

        pager.appendChild(navWrapper);

        // Page numbers with ellipsis
        const pages = document.createElement('div');
        pages.className = 'pagination-pages';
        
        visiblePages.forEach((pageNum, index) => {
          const prevPage = index > 0 ? visiblePages[index - 1] : 0;
          const showEllipsis = pageNum - prevPage > 1;
          
          if (showEllipsis) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'pagination-ellipsis';
            ellipsis.textContent = '…';
            pages.appendChild(ellipsis);
          }
          
          if (pageNum === page) {
            const span = document.createElement('span');
            span.className = 'pagination-current';
            span.setAttribute('aria-current', 'page');
            span.textContent = String(pageNum);
            pages.appendChild(span);
          } else {
            const link = document.createElement('a');
            link.href = '#';
            link.textContent = String(pageNum);
            link.addEventListener('click', (e) => {
              e.preventDefault();
              displaySearchResults(allResults, pageNum);
              resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            pages.appendChild(link);
          }
        });
        pager.appendChild(pages);


        resultsEl.appendChild(pager);
      }

      resultsEl.style.display = 'block';
    }

    // Clear search results and show main content
    function clearSearchResults() {
      const resultsEl = document.getElementById('global-search-results');
      const mainContent = document.getElementById('main-content');
      if (resultsEl && mainContent) {
        resultsEl.style.display = 'none';
        mainContent.style.display = 'block';
      }
    }

    // Clear results when user clears the search input
    if (desktopInput) {
      desktopInput.addEventListener('input', (e) => {
        if (e.target.value.trim().length === 0) {
          clearSearchResults();
        }
      });
    }
    if (mobileInput) {
      mobileInput.addEventListener('input', (e) => {
        if (e.target.value.trim().length === 0) {
          clearSearchResults();
        }
      });
    }
</script>

</body>
</html>
