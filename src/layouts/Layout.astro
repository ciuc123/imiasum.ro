---
import categories from '../data/categories.json';

const {
    title = 'Educație Relațională',
    description = 'Educație Relațională'
} = Astro.props;
---

<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="stylesheet" href="/styles.css" />
</head>

<body>
<header class="site-header">
    <a class="site-title" href="/">Educație Relațională</a>
    <div class="site-navigation">
        <nav class="primary-nav" aria-label="Navigare principală">
            <a href="/blog/">Blog</a>
        </nav>
        <nav class="category-nav" aria-label="Categorii">
            {categories.map((category) => <a href={`/category/${category.slug}/`}>{category.name}</a>)}
        </nav>
    </div>
</header>

<main>
    <slot />
</main>

<footer>
    Educație Relațională
</footer>
</body>
</html>
