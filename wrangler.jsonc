{
  "name": "imiasum-ro",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist"  // ← keep your existing assets directory
  },
  "routes": [
    {
      "pattern": "imiasum.ro",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "imiasum-ro-dev",
      "routes": [
        {
          "pattern": "dev.imiasum.ro",
          "custom_domain": true
        }
      ]
    }
  }
}
